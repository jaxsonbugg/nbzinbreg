# Secrets and API keys (never commit these)
.env
.env.*
*.key
*.pem
secrets*
*credentials*
.Renviron
.httr-oauth

# R temp files and build artifacts
.Rhistory
.RData
.Rproj.user/
*.Rcheck/
*.tar.gz
renv/library/

# Quarto / knitr intermediates (report/report.pdf and docs/ ARE committed)
.quarto/
*.quarto_ipynb
*_cache/
*_files/
# ...but keep figure folders inside the pkgdown site, or Pages loses images
!docs/**/*_files/

# Private and local-only files
docs-private/
.claude/settings.local.json

# Editor, OS, and OneDrive files
.vscode/
Thumbs.db
desktop.ini
.DS_Store
~$*
.Rproj.user

# Checkpoint of the NMES1988 bootstrap run (kept outside the repository)
inst/benchmark/nmes_bootstrap_checkpoint.rds*
